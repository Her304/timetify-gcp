# Rendered by the nginx image's envsubst entrypoint at container start.
# Substituted vars: ${PORT} (set by Cloud Run), ${BACKEND_HOST}.
#
# Replaces the previous inline `echo`-generated config, which served a 200 for
# every URL on the domain (soft 404s) and had no cache or canonical-host rules.

# $host, not $http_host: $http_host carries the port, so a local
# `docker run -p 8080:8080` would arrive as "localhost:8080", miss every entry
# below, and get redirected to production.
map $host $is_canonical_host {
    default                 0;
    "timetify.net"          1;
    "www.timetify.net"      1;
    # Cloud Run's health checks and any local/container probes arrive on other
    # hosts; treating them as canonical keeps them off the redirect path.
    "localhost"             1;
    ""                      1;
}

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # ── Canonical host ────────────────────────────────────────────────────
    # The app answers on timetify.net and two *.run.app hostnames. Left alone
    # that is three copies of every page competing for the same rankings, so
    # everything non-canonical is redirected rather than merely canonical-tagged.
    if ($is_canonical_host = 0) {
        return 301 https://timetify.net$request_uri;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json
               image/svg+xml application/xml application/rss+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # ── Security headers ──────────────────────────────────────────────────
    # HSTS: the canonical-host redirect above already forces https, but that is
    # a per-request server decision — HSTS makes the BROWSER refuse plaintext
    # for a year without asking, which closes the first-request window.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    # Nothing here is ever meant to be framed; blocks clickjacking of the
    # authenticated UI. frame-ancestors in the CSP below is the modern
    # equivalent, this covers browsers that only honour the legacy header.
    add_header X-Frame-Options "DENY" always;
    # No feature in the app uses these; denying by default means a future
    # third-party script can't quietly start asking for them.
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=(), interest-cohort=()" always;

    # Content-Security-Policy. Tokens live in localStorage, so an XSS here is an
    # account takeover (see the security review) — this is the layer that stops
    # injected script from executing or exfiltrating in the first place.
    #
    # Each source is load-bearing; removing one breaks a real feature:
    #   script-src  pagead2.googlesyndication.com → AdSenseLoader.jsx
    #   style-src   'unsafe-inline'  → React style={{...}} attributes, used
    #               throughout (Star/Blob decorations); cannot be removed
    #               without rewriting those to classes.
    #               fonts.googleapis.com → Material Symbols stylesheet
    #   font-src    fonts.gstatic.com → the font files that stylesheet pulls
    #   img-src     storage.googleapis.com → user media (signed URLs)
    #               ${BACKEND_HOST} → avatars via build_absolute_uri
    #   connect-src ${BACKEND_HOST} → the REST API
    #               *.ingest.us.sentry.io → error reporting
    # object-src/base-uri are locked down because they have no legitimate use
    # here and are classic injection footholds.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://pagead2.googlesyndication.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://storage.googleapis.com https://${BACKEND_HOST} https://pagead2.googlesyndication.com; media-src 'self' blob: https://storage.googleapis.com https://${BACKEND_HOST}; connect-src 'self' https://${BACKEND_HOST} https://*.ingest.us.sentry.io; frame-src https://googleads.g.doubleclick.net https://pagead2.googlesyndication.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'" always;

    # ── Hashed build assets ───────────────────────────────────────────────
    # ^~ so this beats the regex route matcher below. Filenames are content
    # hashed by Vite, so they can be cached indefinitely.
    location ^~ /assets/ {
        # No `expires` directive here: it emits its own Cache-Control, which
        # alongside the add_header below produced two conflicting Cache-Control
        # headers on every asset response. max-age is carried in the add_header
        # instead so exactly one is sent.
        #
        # add_header also costs this location the inherited server-level
        # headers, so nosniff is repeated explicitly. CSP is not repeated: it
        # governs documents, and nothing served here is one.
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Self-hosted fonts. Filenames are stable rather than content-hashed, so
    # they get a long-but-revalidatable cache instead of `immutable`.
    location ^~ /fonts/ {
        # Single Cache-Control, for the same reason as /assets/ above.
        add_header Cache-Control "public, max-age=2592000" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # ── Sitemap ───────────────────────────────────────────────────────────
    # Proxied to Django rather than baked into the bundle so a newly published
    # blog post is crawlable without a frontend redeploy. Must be served from
    # the canonical host: a sitemap may only list URLs on its own origin.
    location = /sitemap.xml {
        resolver 169.254.169.254 valid=30s;
        proxy_pass https://${BACKEND_HOST}/sitemap.xml;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Forwarded-Proto https;
    }

    # ── AI-agent bridge (MCP) ─────────────────────────────────────────────
    # Proxied to Django so the address users paste into their agent is
    # https://timetify.net/mcp/v1/ rather than the raw Cloud Run hostname.
    # That URL ends up copied into config files we don't control, so it has to
    # be one we can keep stable if the backend service is ever moved or renamed.
    # Both spellings: Django sets APPEND_SLASH=False, so /mcp/v1 must reach it
    # too instead of 404ing here.
    location ~ ^/mcp/v1/?$ {
        resolver 169.254.169.254 valid=30s;
        proxy_pass https://${BACKEND_HOST}$request_uri;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Forwarded-Proto https;
        # Agents are server-side clients, so no CORS involvement — but the
        # bearer credential must survive the hop.
        proxy_set_header Authorization $http_authorization;
    }

    # ── OAuth for MCP clients that sign in instead of pasting a token ──────
    # The discovery documents are spec-required to live at the root of the same
    # origin the client reached the resource on, and the issuer they advertise
    # must match — so the whole flow has to run on timetify.net, not the Cloud
    # Run hostname. It also means the user sees timetify.net in the address bar
    # while typing their password, which is the point.
    location ~ ^/(\.well-known/oauth-|oauth/) {
        resolver 169.254.169.254 valid=30s;
        proxy_pass https://${BACKEND_HOST}$request_uri;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
        # Django's CSRF check on the consent form compares Origin/Referer
        # against CSRF_TRUSTED_ORIGINS, so the browser's real origin has to
        # survive the proxy rather than being replaced by the backend host.
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Referer $http_referer;
        proxy_set_header Origin $http_origin;
        proxy_set_header Cookie $http_cookie;
        proxy_pass_header Set-Cookie;
    }

    location = /robots.txt {
        expires 1h;
        add_header Cache-Control "public" always;
    }

    # ── HTML documents ────────────────────────────────────────────────────
    # Never cached: prerendered heads change on every deploy, and a stale
    # index.html would pin visitors to deleted asset hashes.
    # `expires -1` rather than `add_header Cache-Control` on every HTML location
    # below. A location that declares ANY add_header stops inheriting the
    # server-level ones, which would silently drop the CSP and HSTS headers from
    # exactly the document responses that need them. `expires` sets
    # Cache-Control directly and leaves inheritance intact.
    location = / {
        expires -1;
        try_files /index.html =404;
    }

    # Known application routes. $uri/index.html picks up the per-route
    # prerendered files (dist/about/index.html, dist/blog/<slug>/index.html);
    # /index.html is the fallback for routes with no prerendered variant,
    # such as /chat/<id>.
    location ~ ^/(about|blog|help|privacy|terms|community|login|register|feed|profile|add-event|Add|class|chat|invite|reset-password)(/.*)?$ {
        expires -1;
        try_files $uri $uri/index.html /index.html;
    }

    # ── Everything else is genuinely missing ──────────────────────────────
    # Serves the SPA shell so the NotFound route still renders, but with a real
    # 404 status so crawlers stop treating typo'd URLs as indexable pages.
    location / {
        try_files $uri $uri/index.html =404;
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
        expires -1;
    }
}
